---
/**
 * Ruler — the tick scale that runs along the bottom of the Greiman
 * spread. Pure CSS gradients: no DOM nodes per tick, so a ruler
 * spanning 4000px is as cheap as one spanning 40.
 */
interface Props {
  /** Pixels between minor ticks. */
  step?: number;
  /** Every Nth tick is full height. */
  major?: number;
  height?: number;
  /** Print the running count above the majors, the whole way. */
  numbered?: boolean;
  /** Widest screen the numbering needs to reach, in px. Anything
   *  past the container is clipped, so over-generating is free. */
  reach?: number;
  /** Ticks hang from the top edge instead of standing on the bottom. */
  flip?: boolean;
  class?: string;
}
const {
  step = 8,
  major = 5,
  height = 14,
  numbered = false,
  reach = 4000,
  flip = false,
  class: className = "",
} = Astro.props;

/* Enough labels to cover `reach`, rather than a fixed two dozen
   that stopped partway across a wide screen. The strip clips, so
   the surplus costs nothing but a few spans. */
const count = numbered ? Math.ceil(reach / (step * major)) : 0;
---

<div
  class:list={["ruler", flip && "ruler--flip", className]}
  aria-hidden="true"
  style={`--step:${step}px; --major:${step * major}px; --h:${height}px`}
>
  {
    numbered && (
      <div class="ruler__nums num">
        {Array.from({ length: count }, (_, i) => (
          <span>{String(i * major).padStart(2, "0")}</span>
        ))}
      </div>
    )
  }
  <div class="ruler__ticks"></div>
</div>

<style>
  .ruler {
    width: 100%;
    overflow: hidden;
    user-select: none;
  }

  .ruler__ticks {
    height: var(--h);
    background-image:
      /* majors */
      repeating-linear-gradient(
        to right,
        var(--ink) 0 1px,
        transparent 1px var(--major)
      ),
      /* minors */
        repeating-linear-gradient(
          to right,
          var(--ink) 0 1px,
          transparent 1px var(--step)
        );
    background-size:
      100% 100%,
      100% 45%;
    background-position:
      0 100%,
      0 100%;
    background-repeat: no-repeat;
  }

  .ruler--flip .ruler__ticks {
    background-position:
      0 0,
      0 0;
  }

  .ruler__nums {
    display: flex;
    font-size: var(--t-xs);
    letter-spacing: var(--track-wide);
    line-height: 1;
    margin-bottom: 3px;
  }

  .ruler__nums span {
    width: var(--major);
    flex: none;
    transform: translateX(2px);
  }
</style>
