---
/**
 * Plate — a numbered figure, set like a page from a design history
 * book: hairline box, caption rule, plate number, and corner
 * registration marks.
 *
 * <Plate no="5.2" caption="April Greiman, Design Quarterly 133">
 *   <Photo src="…" alt="…" />
 * </Plate>
 */
interface Props {
  /** Figure number, e.g. "5.2". Printed before the caption. */
  no?: string;
  caption?: string;
  /** Right-aligned metadata: year, medium, dimensions. */
  meta?: string;
  /** Registration crosses in the corners. */
  marks?: boolean;
  /** Invert the whole plate on hover. */
  hover?: boolean;
  class?: string;
}
const {
  no,
  caption,
  meta,
  marks = true,
  hover = false,
  class: className = "",
} = Astro.props;
---

<figure class:list={["plate", hover && "plate--hover", className]}>
  {
    marks && (
      <>
        <span class="plate__mark plate__mark--tl" aria-hidden="true" />
        <span class="plate__mark plate__mark--tr" aria-hidden="true" />
        <span class="plate__mark plate__mark--bl" aria-hidden="true" />
        <span class="plate__mark plate__mark--br" aria-hidden="true" />
      </>
    )
  }

  <div class="plate__body">
    <slot />
  </div>

  {
    (caption || meta) && (
      <figcaption class="plate__caption">
        <span class="plate__text">
          {no && <span class="plate__no num">{no}</span>}
          {caption}
        </span>
        {meta && <span class="plate__meta num">{meta}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .plate {
    position: relative;
    border: var(--hair);
    background: var(--paper);
  }

  .plate__body {
    position: relative;
    overflow: hidden;
  }

  .plate__caption {
    display: flex;
    gap: var(--s-4);
    align-items: baseline;
    justify-content: space-between;
    border-top: var(--hair);
    padding: var(--s-2) var(--s-3);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    line-height: 1.3;
  }

  .plate__text {
    display: flex;
    gap: var(--s-2);
  }

  .plate__no {
    flex: none;
    font-weight: 700;
  }

  .plate__meta {
    flex: none;
    text-align: right;
  }

  /* Registration crosses, drawn with two pseudo-element bars each. */
  .plate__mark {
    position: absolute;
    width: 9px;
    height: 9px;
    z-index: 2;
    pointer-events: none;
  }
  .plate__mark::before,
  .plate__mark::after {
    content: "";
    position: absolute;
    background: var(--ink);
  }
  .plate__mark::before {
    left: 4px;
    top: 0;
    width: 1px;
    height: 100%;
  }
  .plate__mark::after {
    top: 4px;
    left: 0;
    height: 1px;
    width: 100%;
  }
  .plate__mark--tl {
    left: -5px;
    top: -5px;
  }
  .plate__mark--tr {
    right: -5px;
    top: -5px;
  }
  .plate__mark--bl {
    left: -5px;
    bottom: -5px;
  }
  .plate__mark--br {
    right: -5px;
    bottom: -5px;
  }

  .plate--hover {
    transition: background-color var(--dur-fast) var(--ease-mech),
      color var(--dur-fast) var(--ease-mech);
  }
  .plate--hover:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .plate--hover:hover :global(canvas.dither) {
    filter: invert(1);
  }
</style>
