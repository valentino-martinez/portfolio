---
/**
 * Backdrop — the page's background furniture, generated per page.
 *
 * Mounted once in Base.astro, so every route gets one. The layout
 * is derived from a seed taken from the pathname, which means each
 * page has a different arrangement and each page has the *same*
 * arrangement on every visit — no shuffling between reloads.
 *
 * Two vocabularies, alternating: pixel panels (Mark.astro — coarse
 * 1-bit rectangles, the dissolving blocks and framed sunsets from
 * the Greiman spread) and pen studies (Sketch.astro — perspective
 * construction in line). Everything is data-avoid, so collide.ts
 * decides whether each one actually fits and hides it if not.
 *
 * Positions are percentages of <main>, not of a section, so the
 * set spreads down the whole page rather than clustering.
 */
import Mark from "./Mark.astro";
import Sketch from "./Sketch.astro";
import type { MarkType, SketchType } from "../lib/types";

interface Props {
  /** Anything stable per page — the pathname does nicely. */
  seed: string;
  /** How many pieces to attempt. Some will not fit and will hide. */
  count?: number;
}

const { seed, count = 12 } = Astro.props;

/* FNV-1a, so the arrangement is stable for a given path. */
function hash(s: string): number {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function rng(s: number) {
  let x = s || 1;
  return () => {
    x ^= x << 13; x >>>= 0;
    x ^= x >> 17;
    x ^= x << 5;  x >>>= 0;
    return x / 4294967296;
  };
}
const rand = rng(hash(seed));
const pick = <T,>(xs: readonly T[]) => xs[Math.floor(rand() * xs.length)]!;

/* Rectangular pixel panels, and the square pixel fields. */
const PANELS = ["sunset", "wave", "horizon", "static"] as const satisfies readonly MarkType[];
const FIELDS = ["checker", "dots", "stack"] as const satisfies readonly MarkType[];
const STUDIES = [
  "box", "box-hatch", "cylinder", "cone", "sphere",
  "plane", "ellipses", "spiral", "helix", "target", "chart",
] as const satisfies readonly SketchType[];

const SCREENS = ["solid", "75", "50", "25"] as const;

type Item =
  | { kind: "panel"; type: MarkType; w: number; grid: number; screen: (typeof SCREENS)[number]; frame: boolean; cells: "solid" | "ring" }
  | { kind: "study"; type: SketchType; w: number };

/* Draw without replacement from each pool, refilling only when it
   runs dry. Picking at random every time meant the same panel
   turning up three times on one page. */
function dealer<T>(pool: readonly T[]) {
  let bag: T[] = [];
  return (): T => {
    if (!bag.length) bag = [...pool];
    return bag.splice(Math.floor(rand() * bag.length), 1)[0]!;
  };
}
const nextPanel = dealer(PANELS);
const nextField = dealer(FIELDS);
const nextStudy = dealer(STUDIES);

/* Walk down the page, alternating sides, so the set is spread
   rather than piled up. */
const items: { item: Item; side: "left" | "right"; top: string; seed: number }[] = [];

for (let i = 0; i < count; i++) {
  const t = (i + 0.5) / count;
  const top = `${(4 + t * 88 + (rand() - 0.5) * 5).toFixed(1)}%`;
  const side = i % 2 === 0 ? "left" : "right";

  // Roughly three pixel panels to every two drawings.
  const wantPanel = rand() < 0.6;

  let item: Item;
  if (wantPanel) {
    const rect = rand() < 0.55;
    item = {
      kind: "panel",
      type: rect ? nextPanel() : nextField(),
      w: rect ? 240 + Math.round(rand() * 110) : 210 + Math.round(rand() * 90),
      grid: rect ? 0 : 14 + Math.round(rand() * 8),
      screen: pick(SCREENS),
      frame: rect && rand() < 0.7,
      cells: !rect && rand() < 0.45 ? "ring" : "solid",
    };
  } else {
    item = { kind: "study", type: nextStudy(), w: 200 + Math.round(rand() * 110) };
  }

  items.push({ item, side, top, seed: Math.floor(rand() * 9973) + 1 });
}
---

<div class="backdrop" aria-hidden="true">
  {
    items.map(({ item, side, top, seed: s }) => (
      <span
        class="shape"
        style={`${side}:calc(50% - 50vw); top:${top}`}
        data-avoid
      >
        {item.kind === "panel" ? (
          <Mark
            type={item.type}
            width={`min(26vw, ${item.w}px)`}
            grid={item.grid || undefined}
            seed={s}
            texture={item.screen}
            frame={item.frame}
            cells={item.cells}
          />
        ) : (
          <Sketch type={item.type} width={`min(24vw, ${item.w}px)`} seed={s} />
        )}
      </span>
    ))
  }
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
</style>
