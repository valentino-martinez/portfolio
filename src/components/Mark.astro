---
/**
 * Mark — the drawn objects from the Greiman spread, built out of
 * square tiles instead of smooth strokes.
 *
 * Every shape is defined parametrically and then *rasterised onto a
 * coarse grid at build time*: we walk the curve, mark whichever cell
 * each sample lands in, and emit one <rect> per cell. So an ellipse
 * is not a smooth ellipse — it is the blocks an ellipse would light
 * up on a very low-resolution screen, which is the same logic the
 * bitmap type and the dithered photographs are built on.
 *
 * Pure build-time geometry with a seeded PRNG: same markup every
 * build, no image requests, inverts with the page.
 *
 *   <Mark type="orbit" width="140px" grid={14} />
 *
 * `width` takes any CSS length, so a mark can be a 40px dingbat or
 * a shape that bleeds off both edges of the screen. Drop `grid` as
 * you go bigger: the tiles should stay large and countable, not
 * dissolve into a fine screen.
 */
import type { MarkType } from "../lib/types";

interface Props {
  type: MarkType;
  /** Any CSS length. The mark is square, so height follows. */
  width?: string;
  /** Size from the height instead — e.g. "100%" to match a sibling.
   *  Takes precedence over `width`. */
  height?: string;
  /** Deterministic variation — same seed, same mark, every build. */
  seed?: number;
  /** Cells across. Lower = chunkier. Go coarse when you go large. */
  grid?: number;
  /**
   * Knocks cells out of the filled areas on an ordered 4×4 matrix,
   * turning solid ink into a screen. "50" is a fine checker, "25" a
   * quarter tint. The same trick a 1-bit machine used for grey.
   */
  texture?: "solid" | "75" | "50" | "25";
  /** A stepped pixel border around the shape, corners notched. */
  frame?: boolean;
  /**
   * How each cell is drawn.
   *  solid — a filled square
   *  ring  — a square with its middle punched out, so the cell has
   *          a border and reads lighter without any transparency
   *  dot   — filled, with a small hole at the centre
   * The holes are real holes: one path, fill-rule evenodd. Nothing
   * is tinted and nothing is semi-transparent.
   */
  cells?: "solid" | "ring" | "dot";
  class?: string;
}

const {
  type,
  width = "96px",
  height,
  seed = 1,
  grid = 22,
  texture = "solid",
  frame = false,
  cells = "solid",
  class: className = "",
} = Astro.props;

const N = Math.max(6, grid);

/* Most marks are square line-drawings on a gutter grid. The panel
   shapes — sunset, wave — are wider than tall and solid, because
   they are blocks of ink rather than drawings. */
const PANEL: Partial<Record<MarkType, { cols: number; rows: number }>> = {
  sunset: { cols: 18, rows: 12 },
  wave: { cols: 20, rows: 11 },
  arc: { cols: 22, rows: 9 },
};
const shape = PANEL[type];
const COLS = shape ? shape.cols : N;
const ROWS = shape ? shape.rows : N;

const CELL = 10;
/* Solid panels have no gutter; drawn marks keep one so they read as
   strokes rather than mass. */
const GAP = type === "sunset" || type === "wave" ? 0 : 1.6;
const VB_W = COLS * CELL;
const VB_H = ROWS * CELL;
const MID = (N - 1) / 2;

/* Deterministic PRNG. Math.random() would redraw every mark on every
   build, which makes diffs and caching miserable. */
function rng(s: number) {
  let x = (s * 1664525 + 1013904223) >>> 0;
  return () => {
    x ^= x << 13; x >>>= 0;
    x ^= x >> 17;
    x ^= x << 5;  x >>>= 0;
    return x / 4294967296;
  };
}
const rand = rng(seed || 1);

/* ---- the rasteriser ----------------------------------------- */

const on = new Set<number>();
const plot = (x: number, y: number) => {
  const gx = Math.round(x);
  const gy = Math.round(y);
  if (gx >= 0 && gx < COLS && gy >= 0 && gy < ROWS) on.add(gy * COLS + gx);
};
const clear = (x: number, y: number) => on.delete(y * COLS + x);

function walkEllipse(rx: number, ry: number, rotDeg: number) {
  const rot = (rotDeg * Math.PI) / 180;
  const c = Math.cos(rot);
  const s = Math.sin(rot);
  // Oversample so no cell is skipped on the flat parts of the curve.
  const steps = Math.ceil(Math.max(rx, ry) * 24);
  for (let i = 0; i < steps; i++) {
    const t = (i / steps) * Math.PI * 2;
    const x = Math.cos(t) * rx;
    const y = Math.sin(t) * ry;
    plot(MID + x * c - y * s, MID + x * s + y * c);
  }
}

function walkLine(x0: number, y0: number, x1: number, y1: number) {
  const steps = Math.ceil(Math.hypot(x1 - x0, y1 - y0) * 3) || 1;
  for (let i = 0; i <= steps; i++) {
    plot(x0 + ((x1 - x0) * i) / steps, y0 + ((y1 - y0) * i) / steps);
  }
}

function fillRect(x0: number, y0: number, w: number, h: number) {
  for (let y = y0; y < y0 + h; y++) {
    for (let x = x0; x < x0 + w; x++) plot(x, y);
  }
}

/* ---- the shapes ---------------------------------------------- */

const R = MID - 0.5;

switch (type) {
  case "sunset": {
    // A solid panel with a disc lifted out of it, then a horizon
    // band laid back over the disc's lower half so it reads as
    // half-sunk — the framed sunset from the poster.
    fillRect(0, 0, COLS, ROWS);
    const cx = COLS * 0.5;
    const cy = ROWS * 0.54;
    const r = ROWS * 0.34;
    for (let y = 0; y < ROWS; y++) {
      for (let x = 0; x < COLS; x++) {
        // Cells are square, so no aspect correction is needed.
        if (Math.hypot(x + 0.5 - cx, y + 0.5 - cy) < r) clear(x, y);
      }
    }
    const horizon = Math.round(ROWS * 0.62);
    fillRect(0, horizon, COLS, ROWS - horizon);
    break;
  }

  case "wave": {
    // Horizontal runs of ink at varying length and offset: the
    // banded video static that fills a block in the original.
    for (let y = 0; y < ROWS; y++) {
      let x = 0;
      while (x < COLS) {
        const run = 1 + Math.floor(rand() * 4);
        const gapRun = 1 + Math.floor(rand() * 3);
        // Denser at the top, thinning downward.
        if (rand() < 1 - y / (ROWS * 1.4)) {
          for (let i = 0; i < run && x + i < COLS; i++) plot(x + i, y);
        }
        x += run + gapRun;
      }
    }
    break;
  }

  case "arc": {
    // The long shallow curve the figure lies along. Bottom half of
    // a very wide ellipse, one cell thick.
    const rx = COLS / 2 - 0.5;
    const ry = ROWS - 1.5;
    const steps = COLS * 12;
    for (let i = 0; i <= steps; i++) {
      const th = Math.PI * (i / steps);
      plot(COLS / 2 - 0.5 + Math.cos(th) * rx, 0.5 + Math.sin(th) * ry);
    }
    break;
  }

  case "orbit": {
    for (let i = 0; i < 4; i++) {
      const rx = R - i * 1.9;
      walkEllipse(rx, rx * (0.26 + rand() * 0.24), -30 + i * 26 + rand() * 14);
    }
    break;
  }

  case "ring": {
    walkEllipse(R, R * (0.34 + rand() * 0.2), -22 + rand() * 34);
    break;
  }

  case "spiral": {
    const turns = 3.2;
    const steps = 1400;
    for (let i = 0; i <= steps; i++) {
      const th = (i / steps) * turns * Math.PI * 2;
      const r = (i / steps) * R;
      plot(MID + Math.cos(th) * r, MID + Math.sin(th) * r);
    }
    break;
  }

  case "target": {
    walkEllipse(R, R, 0);
    walkEllipse(R * 0.52, R * 0.52, 0);
    walkLine(MID, 0, MID, N - 1);
    walkLine(0, MID, N - 1, MID);
    fillRect(Math.round(MID) - 1, Math.round(MID) - 1, 2, 2);
    break;
  }

  case "bars": {
    // A tick chart: columns under a lobed envelope.
    for (let x = 0; x < N; x++) {
      const t = x / (N - 1);
      const env = Math.pow(Math.sin(t * Math.PI), 0.6);
      const h = Math.max(1, Math.round(env * (N - 2) * (0.45 + rand() * 0.55)));
      for (let y = 0; y < h; y++) plot(x, N - 1 - y);
    }
    break;
  }

  case "stack": {
    // A staircase of solid squares, each tread smaller than the last.
    let x = 0;
    let y = N - 1;
    let s = Math.max(2, Math.round(N * 0.3));
    while (s >= 1 && x < N && y - s >= -1) {
      fillRect(Math.round(x), Math.round(y - s + 1), s, s);
      x += s * 0.85;
      y -= s * 0.5;
      s -= 1;
    }
    break;
  }

  case "checker": {
    // A checkerboard losing its grip left to right.
    for (let y = 0; y < N; y++) {
      for (let x = 0; x < N; x++) {
        const keep = 1 - x / (N - 1);
        if ((x + y) % 2 === 0 && rand() < keep * 1.2) plot(x, y);
      }
    }
    break;
  }

  case "dots": {
    for (let y = 0; y < N; y++) {
      for (let x = 0; x < N; x++) {
        const keep = 1 - x / (N - 1);
        if (rand() < keep * keep * 1.25) plot(x, y);
      }
    }
    break;
  }
}

/* ---- screening and border ---------------------------------- */

/* A 4×4 ordered matrix. Cells whose threshold sits above the level
   are dropped, so a solid field becomes a regular tint rather than
   a random scatter — which is what makes it read as a screen and
   not as noise. */
if (texture !== "solid") {
  const BAYER4 = [
    [0, 8, 2, 10],
    [12, 4, 14, 6],
    [3, 11, 1, 9],
    [15, 7, 13, 5],
  ];
  const level = texture === "75" ? 12 : texture === "50" ? 8 : 4;
  for (const i of [...on]) {
    const x = i % COLS;
    const y = Math.floor(i / COLS);
    if (BAYER4[y % 4]![x % 4]! >= level) on.delete(i);
  }
}

if (frame) {
  // Outer ring, then the four corner cells removed and stepped back
  // in by one — the chamfered corner of an old interface box.
  for (let x = 0; x < COLS; x++) {
    plot(x, 0);
    plot(x, ROWS - 1);
  }
  for (let y = 0; y < ROWS; y++) {
    plot(0, y);
    plot(COLS - 1, y);
  }
  for (const [cxi, cyi] of [
    [0, 0],
    [COLS - 1, 0],
    [0, ROWS - 1],
    [COLS - 1, ROWS - 1],
  ] as [number, number][]) {
    clear(cxi, cyi);
    plot(cxi === 0 ? 1 : COLS - 2, cyi === 0 ? 1 : ROWS - 2);
  }
}

/* ---- emit ---------------------------------------------------- */

/* Solid cells merge along each row into runs, so a stroke is one
   rect with no seam. Ring and dot cells cannot merge — each needs
   its own hole — so they are emitted per cell as a two-subpath
   figure and punched out with fill-rule="evenodd". */

const tiles: { x: number; y: number; w: number; h: number }[] = [];
let holePath = "";

const rect = (x: number, y: number, w: number, h: number) =>
  `M${x},${y}h${w}v${h}h${-w}Z`;

if (cells === "solid") {
  for (let y = 0; y < ROWS; y++) {
    let x = 0;
    while (x < COLS) {
      if (!on.has(y * COLS + x)) {
        x++;
        continue;
      }
      const start = x;
      while (x < COLS && on.has(y * COLS + x)) x++;
      if (GAP > 0) {
        for (let k = start; k < x; k++) {
          tiles.push({ x: k * CELL, y: y * CELL, w: CELL - GAP, h: CELL - GAP });
        }
      } else {
        tiles.push({
          x: start * CELL,
          y: y * CELL,
          w: (x - start) * CELL,
          h: CELL,
        });
      }
    }
  }
} else {
  // Wall thickness of the ring, in viewBox units.
  const size = CELL - GAP;
  const inset = cells === "ring" ? size * 0.3 : size * 0.34;
  const holeW = cells === "ring" ? size - inset * 2 : size * 0.3;
  for (const i of on) {
    const x = (i % COLS) * CELL;
    const y = Math.floor(i / COLS) * CELL;
    const hx = x + (size - holeW) / 2;
    const hy = y + (size - holeW) / 2;
    holePath += rect(x, y, size, size) + rect(hx, hy, holeW, holeW);
  }
}

---

<svg
  class:list={["mark", `mark--${type}`, className]}
  style={`${height ? `height:${height};width:auto` : `width:${width}`};aspect-ratio:${COLS} / ${ROWS}`}
  viewBox={`0 0 ${VB_W} ${VB_H}`}
  aria-hidden="true"
  focusable="false"
  shape-rendering="crispEdges"
>
  {tiles.map((t) => <rect x={t.x} y={t.y} width={t.w} height={t.h} fill="currentColor" />)}

  {/* One path for every ringed cell. evenodd turns the inner
      subpath into a genuine hole, not a paper-coloured patch, so
      the mark still works over anything behind it. */}
  {holePath && <path d={holePath} fill="currentColor" fill-rule="evenodd" />}
</svg>

<style>
  .mark {
    display: block;
    color: inherit;
    flex: none;
    max-width: 100%;
    /* The ratio is set inline per shape. Stating it at all is what
       lets `height: X; width: auto` resolve — without it the width
       collapses to 0 in a flex or absolutely positioned box. */
  }
</style>
