---
/**
 * SectionHead — the chapter opener. A numbered rule, a big bitmap
 * title, and an optional standfirst set in two columns.
 */
import Ruler from "./Ruler.astro";

interface Props {
  /** Chapter number, e.g. "03". */
  index?: string;
  title: string;
  /** Short line above the title. */
  kicker?: string;
  /** Longer intro under the title. */
  lede?: string;
  /** Right-hand counter, e.g. "12 ENTRIES". */
  count?: string;
}
const {
  index,
  title,
  kicker,
  lede,
  count,
} = Astro.props;
---

<header class="head page">
  <div class="head__top">
    <span class="label label--wide">
      {index && <span class="head__idx num">{index}</span>}
      {kicker ?? title}
    </span>
    {count && <span class="label num head__count">{count}</span>}
  </div>

  <Ruler step={6} major={6} height={10} />

  <h1 class="head__title title title--xl" data-reveal>{title}</h1>

  {
    lede && (
      <p class="head__lede" data-reveal>
        {lede}
      </p>
    )
  }
</header>

<style>
  .head {
    padding-top: var(--s-8);
    padding-bottom: var(--s-8);
  }

  .head__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    margin-bottom: var(--s-1);
  }

  .head__idx {
    margin-right: 0.8em;
  }


  .head__title {
    margin-block: var(--s-6) 0;
  }

  .head__lede {
    margin-top: var(--s-6);
    max-width: var(--measure);
    font-size: var(--t-md);
    line-height: var(--lead-snug);
  }
</style>
