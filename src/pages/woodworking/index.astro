---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import MakeGrid from "../../components/MakeGrid.astro";
import type { MakeItem, TextureType } from "../../lib/types";
import { byDateDesc, publicOnly } from "../../lib/format";

const pieces = publicOnly(await getCollection("woodworking")).sort(byDateDesc);

/* Each plate without a photograph gets a worked surface instead,
   cycling so neighbours never share one. */
const TEXTURES: TextureType[] = ["hatch", "grid", "ramp"];

const items: MakeItem[] = pieces.map((piece, i) => ({
  href: `/woodworking/${piece.id}/`,
  no: piece.data.plate ?? `5.${i + 1}`,
  title: piece.data.title,
  summary: piece.data.summary,
  cover: piece.data.cover,
  coverAlt: piece.data.coverAlt,
  texture: TEXTURES[i % TEXTURES.length]!,
  seed: i * 17 + 4,
  status: piece.data.status.replace("-", " ").toUpperCase(),
  specs: [
    piece.data.species.join(", "),
    piece.data.joinery.join(", "),
    piece.data.finish,
  ].filter((v): v is string => Boolean(v)),
}));

---

<Base
  title="Woodworking"
  section="Woodworking — 05"
  description="Furniture, boxes and shop fixtures, mostly cut by hand."
>
  <SectionHead
    index="05"
    title="Woodworking"
    kicker="Wood"
    count={`${items.length} ${items.length === 1 ? "piece" : "pieces"}`}
    lede="Hand tools where it matters and machines where it does not. Joinery I can explain, finishes I am still learning."
  />

  <div class="page">
    <MakeGrid
      items={items}
      empty="Nothing built yet — add a file to src/content/woodworking/."
    />
  </div>
</Base>
