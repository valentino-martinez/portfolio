---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Entry from "../../layouts/Entry.astro";
import { byDateDesc, publicOnly, readMinutes } from "../../lib/format";

export async function getStaticPaths() {
  const posts = publicOnly(await getCollection("blog")).sort(byDateDesc);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Newest first, so the entry after this one in the array is older.
      prev: posts[i - 1] ?? null,
      next: posts[i + 1] ?? null,
    },
  }));
}

type Props = {
  post: CollectionEntry<"blog">;
  prev: CollectionEntry<"blog"> | null;
  next: CollectionEntry<"blog"> | null;
};

const { post, prev, next } = Astro.props as Props;
const { Content } = await render(post);
const minutes = post.data.minutes ?? readMinutes(post.body);
---

<Entry
  title={post.data.title}
  summary={post.data.summary}
  section="Blog — 03"
  date={post.data.date}
  updated={post.data.updated}
  tags={post.data.tags}
  specs={[{ label: "Read", value: `${minutes} min` }]}
  backHref="/blog/"
  backLabel="All posts"
  prev={prev ? { href: `/blog/${prev.id}/`, title: prev.data.title } : null}
  next={next ? { href: `/blog/${next.id}/`, title: next.data.title } : null}
>
  <Content />
</Entry>
