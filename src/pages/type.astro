---
/**
 * /type — specimen for the display face.
 *
 * Not linked from the site. It exists so the titling can be judged
 * at real sizes, and so it is obvious whether BigBlue Terminal has
 * actually loaded or the stack has fallen back. Delete whenever.
 */
import Base from "../layouts/Base.astro";

const sizes = [
  { label: "Masthead", cls: "title--sm" },
  { label: "Entry title", cls: "title--lg" },
  { label: "Section head", cls: "title--xl" },
];

const lines = [
  "Valentino Martinez",
  "About",
  "Projects",
  "Ceramics",
  "Woodworking",
];
---

<Base title="Type specimen" section="Specimen — display face" ticker={false}>
  <div class="page sheet">
    <p class="sheet__intro">
      Titles are set in <strong>BigBlue Terminal</strong>, an 8×12 console
      font drawn from the 8×14 EGA/VGA charset. It is not bundled —
      see <code>public/fonts/README.md</code>. If the line below looks
      like your ordinary monospace, the file is not installed yet and
      the stack has fallen back, which is a working state, not a bug.
    </p>

    <section class="spec">
      <h2 class="label spec__h">Loaded?</h2>
      <p class="probe" data-probe>checking…</p>
    </section>

    <section class="spec">
      <h2 class="label spec__h">Character set</h2>
      <p class="title spec__set">ABCDEFGHIJKLMNOPQRSTUVWXYZ</p>
      <p class="title spec__set">0123456789 !?&amp;.,:;'"-+/\\|</p>
      <p class="title spec__set">░▒▓█▄▀■□▪▫→←↑↓↔</p>
    </section>

    {
      sizes.map((s) => (
        <section class="spec">
          <h2 class="label spec__h">{s.label}</h2>
          {lines.map((line) => (
            <p class:list={["title", s.cls, "spec__line"]}>{line}</p>
          ))}
        </section>
      ))
    }
  </div>

  <script>
    // document.fonts.check needs a size and the exact family name.
    const el = document.querySelector("[data-probe]");
    if (el) {
      const run = () => {
        const ok = document.fonts.check('16px "BigBlue Terminal"');
        el.textContent = ok
          ? "BigBlue Terminal is loaded."
          : "Not installed — falling back to the system console stack.";
        el.setAttribute("data-ok", String(ok));
      };
      document.fonts.ready.then(run).catch(run);
    }
  </script>
</Base>

<style>
  .sheet {
    padding-block: var(--s-8) var(--s-16);
  }

  .sheet__intro {
    max-width: var(--measure);
    margin-bottom: var(--s-12);
  }

  .spec {
    margin-bottom: var(--s-12);
    border-top: var(--hair);
    padding-top: var(--s-3);
  }

  .spec__h {
    margin-bottom: var(--s-4);
  }

  .spec__set {
    font-size: var(--t-md);
    margin-bottom: var(--s-2);
    word-break: break-all;
  }

  .spec__line + .spec__line {
    margin-top: var(--s-3);
  }

  .probe {
    border: var(--hair);
    padding: var(--s-2) var(--s-3);
    display: inline-block;
    font-size: var(--t-sm);
  }
  .probe[data-ok="true"] {
    background: var(--ink);
    color: var(--paper);
  }
</style>
