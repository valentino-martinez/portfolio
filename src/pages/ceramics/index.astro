---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import MakeGrid from "../../components/MakeGrid.astro";
import type { MakeItem } from "../../lib/types";
import { byDateDesc, publicOnly } from "../../lib/format";

const pots = publicOnly(await getCollection("ceramics")).sort(byDateDesc);

const items: MakeItem[] = pots.map((pot, i) => ({
  href: `/ceramics/${pot.id}/`,
  no: pot.data.plate ?? `4.${i + 1}`,
  title: pot.data.title,
  summary: pot.data.summary,
  cover: pot.data.cover,
  coverAlt: pot.data.coverAlt,
  status: pot.data.status.replace("-", " ").toUpperCase(),
  specs: [pot.data.clay, pot.data.glaze, pot.data.firing].filter(
    (v): v is string => Boolean(v)
  ),
}));

---

<Base
  title="Ceramics"
  section="Ceramics — 04"
  description="Thrown and hand-built pots, glaze tests, and things that came out of the kiln."
>
  <SectionHead
    index="04"
    title="Ceramics"
    kicker="Clay"
    count={`${items.length} ${items.length === 1 ? "piece" : "pieces"}`}
    lede="Wheel-thrown, mostly stoneware, mostly at cone 6. Photographed badly, dithered deliberately."
  />

  <div class="page">
    <MakeGrid
      items={items}
      empty="No pots yet — add a file to src/content/ceramics/."
    />
  </div>
</Base>
