---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import Plate from "../../components/Plate.astro";
import Photo from "../../components/Photo.astro";
import Texture from "../../components/Texture.astro";
import { byDateDesc, publicOnly } from "../../lib/format";

const projects = publicOnly(await getCollection("projects"))
  .sort(byDateDesc)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

---

<Base
  title="Projects"
  description="Selected design and build work."
>
  <SectionHead
    index="01"
    title="Projects"
    kicker="Work"
    count={`${projects.length} ${projects.length === 1 ? "plate" : "plates"}`}
    lede="Things I designed, built, or both. Each one is here because I learned something making it."
  />

  <div class="page">
    {
      projects.length > 0 ? (
        <div class="grid" data-reveal-group="110">
          {projects.map((p, i) => (
            <a class="card" href={`/projects/${p.id}/`} data-reveal>
              <Plate
                no={p.data.plate ?? `2.${i + 1}`}
                caption={p.data.title}
                meta={String(p.data.year)}
                hover
              >
                {p.data.cover ? (
                  <Photo src={p.data.cover} alt={p.data.coverAlt ?? ""} ratio="4/3" />
                ) : (
                  <div class="plate-empty plate-empty--4x3">
                    <Texture type={["contour", "hatch", "ramp"][i % 3] as never} seed={i * 13 + 2} density={0.45} />
                  </div>
                )}
                <div class="card__summary">
                  <p>{p.data.summary}</p>
                  <p class="label card__specs">
                    {[p.data.role, p.data.context, ...p.data.tools]
                      .filter(Boolean)
                      .join(" · ")}
                  </p>
                </div>
              </Plate>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty label">No projects yet.</p>
      )
    }
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--s-8);
    margin-bottom: var(--s-16);
  }


  /* ---------- cards ------------------------------------------
     The summary rides inside the plate, parked below its bottom
     edge and clipped by it, and slides up on hover or keyboard
     focus. Transform only — nothing animates width or height, so
     this stays on the compositor. */
  .card {
    text-decoration: none;
    display: block;
  }

  .card__summary {
    /* Bottom-anchored and auto-height, so it is only as tall as the
       words and the artwork still shows above it. */
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: var(--s-4);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--t-sm);
    line-height: var(--lead-body);
    transform: translateY(100%);
    transition: transform var(--dur-base) var(--ease-mech);
  }

  .card:hover .card__summary,
  .card:focus-visible .card__summary {
    transform: none;
  }

  /* A small lift, so the whole plate answers the pointer and not
     just the panel. */
  .card:hover :global(.plate) {
    transform: translateY(-3px);
  }
  .card :global(.plate) {
    transition: transform var(--dur-base) var(--ease-mech);
  }

  /* A more deliberate entrance than the page default: further to
     travel, longer to settle. The stagger comes from the group. */
  :global(html.js-ready) .card[data-reveal] {
    --reveal-shift: 24px;
    transition-duration: 520ms;
  }

  /* No pointer, so there is no hover to wait for: print it. */
  @media (hover: none) {
    .card__summary {
      position: static;
      transform: none;
      padding: 0;
      margin-top: var(--s-3);
      background: none;
      color: inherit;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__summary,
    .card :global(.plate) {
      transition: none;
    }
  }

  .card__specs {
    margin: 0;
  }

  .empty {
    border: var(--rule) dashed var(--ink);
    padding: var(--s-8);
    text-align: center;
  }
</style>
