---
import { existsSync, readdirSync } from "node:fs";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Texture from "../components/Texture.astro";
import Plate from "../components/Plate.astro";
import { site } from "../site";
import { byDateDesc, publicOnly } from "../lib/format";

const projects = publicOnly(await getCollection("projects"))
  .sort(byDateDesc)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);

/* The headshot. Drop any `portrait.*` into public/media/ and it is
   picked up here at build time — no code change, no config. Until
   then the hero holds an empty plate at the same proportions, so the
   layout does not move when the photograph arrives. */
const MEDIA = "public/media";
const portrait = existsSync(MEDIA)
  ? readdirSync(MEDIA)
      .filter((f) => /^portrait\.(jpe?g|png|webp|avif)$/i.test(f))
      .map((f) => `/media/${f}`)[0]
  : undefined;
---

<Base description={site.description}>
  {/* ============ THE POSTER =====================================
      Two masses on a diagonal: the plate at the right trim, the
      wordmark panel holding the left. Nothing centred in a void.
      ============================================================ */}
  <section class="poster" id="poster">
    <div class="poster__sheet">

      {/* The photograph, mounted: a paper mat, then the picture
          itself cropped in on the subject. The inner box is what
          clips the zoom, so the scale never spills onto the mat. */}
      <figure class="poster__figure">
        <div class="poster__shot">
          {
            portrait ? (
              <Photo src={portrait} alt={site.name} ratio="3/2" loading="eager" />
            ) : (
              <div class="plate-empty plate-empty--portrait">
                <span class="label num">PORTRAIT</span>
              </div>
            )
          }
        </div>
      </figure>

      {/* The wordmark is artwork: the field, the name and the role
          line are all baked into one 4x export, so the alt text has
          to carry both lines. */}
      <h1 class="poster__block">
        <img
          class="poster__mark"
          src="/media/wordmark.png"
          alt={`${site.name} — ${site.role}`}
          width="838"
          height="341"
          loading="eager"
        />
      </h1>
    </div>
  </section>

  {/* ============ WORK ============================================ */}
  <section class="page section" id="work">

    <div class="section__head">
      <h2 class="label label--wide">
        <span class="section__no num">01</span> Selected Work
      </h2>
      <a class="section__more label" href="/projects/" data-scramble>
        All projects →
      </a>
    </div>

    {
      projects.length > 0 ? (
        <div class="grid grid--3" data-reveal-group="110">
          {projects.map((p, i) => (
            <a class="card" href={`/projects/${p.id}/`} data-reveal>
              <Plate
                no={p.data.plate ?? `2.${i + 1}`}
                caption={p.data.title}
                meta={String(p.data.year)}
                hover
              >
                {p.data.cover ? (
                  <Photo src={p.data.cover} alt={p.data.coverAlt ?? ""} ratio="4/3" />
                ) : (
                  <div class="plate-empty plate-empty--4x3">
                    <Texture type={["hatch", "ramp", "contour"][i % 3] as never} seed={i * 7 + 3} density={0.45} />
                  </div>
                )}
                <p class="card__summary">{p.data.summary}</p>
              </Plate>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty label">
          No projects yet — add a markdown file to src/content/projects/.
        </p>
      )
    }
  </section>





  {/* ============ CLOSING ========================================= */}
  <section class="page section" id="close">

    <div class="closing">
      <Plate no="0.2" caption="Plate reserved" meta="EMPTY">
        <div class="plate-empty plate-empty--16x9">
          <Texture type="scan" seed={29} density={0.55} />
        </div>
      </Plate>

      <div class="closing__note">
        <p class="label" data-reveal>Say hello</p>
        <p class="closing__big" data-reveal>
          <a href={`mailto:${site.email}`} data-scramble="both">
            {site.email}
          </a>
        </p>
        <p class="closing__body" data-reveal>
          I like talking about typography, glaze chemistry, hand tools,
          and why early computer graphics looked the way they did. If
          you want to work together, or just argue about Atkinson versus
          Floyd–Steinberg, the inbox is open.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- the poster --------------------------------------
     Nothing here is in a box. The shapes are larger than the
     viewport on purpose: you are looking at a detail of something
     bigger, which is what makes them read as objects rather than
     icons. --------------------------------------------------- */

  .poster {
    position: relative;
    /* Display width of the wordmark. The artwork is a 4x export at
       838x341, so every size here samples it down — which is why
       there is no image-rendering override. */
    --mark-w: 340px;
    padding-top: var(--s-8);
    /* Room for the wordmark to hang below the picture. */
    padding-bottom: var(--s-12);
  }

  @media (min-width: 52rem) {
    .poster {
      --mark-w: 420px;
    }
  }

  @media (min-width: 60rem) {
    .poster {
      --mark-w: 500px;
    }
  }

  @media (min-width: 80rem) {
    .poster {
      --mark-w: 600px;
    }
  }


  /* Ten columns of paper. Everything below places itself on these,
     so the overlaps survive a reflow instead of being nudged into
     position with percentages. */
  .poster__sheet {
    position: relative;
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    align-items: start;
    /* The same column as every other section, so the masthead shares
       one left edge with the page instead of bleeding past it. */
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ---------- the photograph ---------------------------------
     Held to the right trim and run large, with the wordmark lying
     across its bottom left corner. */
  .poster__figure {
    grid-column: 4 / 11;
    grid-row: 1;
    justify-self: end;
    width: 100%;
    margin: 0;
    z-index: 0;
  }

  /* Clips the zoom below, so the enlarged picture cannot paint over
     the mat around it. */
  .poster__shot {
    overflow: hidden;
  }

  .poster__shot :global(.photo) {
    /* Cropped in on the subject. The source is the same 3:2 frame;
       this just enlarges it inside a box of that shape. */
    transform: scale(1.22);
    transform-origin: 50% 42%;
  }

  /* ---------- the wordmark ----------------------------------
     Placed, not drawn — the export carries its own field, type and
     notched edge. */
  .poster__block {
    /* Same row as the photograph, pinned to its foot, so the mark
       lies across the bottom left of the picture and hangs below
       it. */
    grid-column: 1 / 7;
    grid-row: 1;
    align-self: end;
    justify-self: start;
    margin: 0 0 calc(var(--s-12) * -1);
    /* The width lives on the wrapper, not the image: an <img> with
       max-width:100% inside a shrink-to-fit box sizes itself from a
       box that is sized from it, and collapses to its intrinsic
       width. */
    width: var(--mark-w);
    max-width: 100%;
    z-index: 1;
    line-height: 0;
  }

  .poster__mark {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The mark is a fixed raster — light type on a dark field — so it
     has to be flipped by hand when the page flips, or it sits as a
     dark block on dark paper. These two conditions mirror the ones
     tokens.css uses to swap ink and paper, including the no-JS case
     where the attribute is still at its "off" default. */
  :global(html[data-invert="on"]) .poster__mark {
    filter: invert(1);
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-invert="off"])) .poster__mark {
      filter: invert(1);
    }
  }




  /* The tracked-out ghost line under the chain. */

  @media (max-width: 52rem) {
    /* One column: the picture runs full width and the wordmark
       still lies across the foot of it. */
    .poster__figure {
      grid-column: 1 / 11;
      justify-self: start;
    }
    .poster__block {
      grid-column: 1 / 10;
      margin-bottom: calc(var(--s-8) * -1);
    }
  }


  /* ---------- section chrome ---------------------------------
     No rules between sections on this page: a full-width hairline
     every few screens turns one sheet back into a stack of bands,
     which is exactly what the shapes are there to dissolve. The
     z-index lifts the content clear of the field layer. */
  .section {
    border-top: 0;
  }

  /* Content sits above the shape layer. */
  .section > *:not(.shape) {
    position: relative;
    z-index: 1;
  }

  .section__no {
    margin-right: 0.8em;
  }

  .section__more a,
  a.section__more {
    text-decoration: none;
    border-bottom: var(--hair);
  }
  .section__more a:hover,
  a.section__more:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .empty {
    border: var(--rule) dashed var(--ink);
    padding: var(--s-6);
    text-align: center;
  }

  /* ---------- grids ------------------------------------------ */
  .grid {
    display: grid;
    gap: var(--s-6);
  }
  .grid--3 {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .grid--4 {
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    margin-top: var(--s-6);
  }


  /* ---------- cards ------------------------------------------
     The summary rides inside the plate, parked below its bottom
     edge and clipped by it, and slides up on hover or keyboard
     focus. Transform only — nothing animates width or height, so
     this stays on the compositor. */
  .card {
    text-decoration: none;
    display: block;
  }

  .card__summary {
    /* Bottom-anchored and auto-height, so it is only as tall as the
       words and the artwork still shows above it. */
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: var(--s-4);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--t-sm);
    line-height: var(--lead-body);
    transform: translateY(100%);
    transition: transform var(--dur-base) var(--ease-mech);
  }

  .card:hover .card__summary,
  .card:focus-visible .card__summary {
    transform: none;
  }

  /* A small lift, so the whole plate answers the pointer and not
     just the panel. */
  .card:hover :global(.plate) {
    transform: translateY(-3px);
  }
  .card :global(.plate) {
    transition: transform var(--dur-base) var(--ease-mech);
  }

  /* A more deliberate entrance than the page default: further to
     travel, longer to settle. The stagger comes from the group. */
  :global(html.js-ready) .card[data-reveal] {
    --reveal-shift: 24px;
    transition-duration: 520ms;
  }

  /* No pointer, so there is no hover to wait for: print it. */
  @media (hover: none) {
    .card__summary {
      position: static;
      transform: none;
      padding: 0;
      margin-top: var(--s-3);
      background: none;
      color: inherit;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__summary,
    .card :global(.plate) {
      transition: none;
    }
  }

  .card__blank {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background-image: repeating-linear-gradient(
      45deg,
      var(--ink) 0 1px,
      transparent 1px 7px
    );
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: var(--hair);
  }

  /* ---------- closing ---------------------------------------- */
  .closing {
    display: grid;
    gap: var(--s-8);
  }

  @media (min-width: 60rem) {
    .closing {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--s-16);
      align-items: center;
    }
  }

  .closing__big {
    font-size: var(--t-lg);
    line-height: var(--lead-tight);
    margin-block: var(--s-3);
    word-break: break-word;
  }

  .closing__big a {
    text-decoration: none;
    border-bottom: var(--rule-thick) solid var(--ink);
  }
  .closing__big a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .closing__body {
    font-size: var(--t-sm);
    line-height: var(--lead-body);
    max-width: 32rem;
  }
</style>
