---
import { existsSync, readdirSync } from "node:fs";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Texture from "../components/Texture.astro";
import Plate from "../components/Plate.astro";
import EntryRow from "../components/EntryRow.astro";
import Ruler from "../components/Ruler.astro";
import ToneScale from "../components/ToneScale.astro";
import { site } from "../site";
import { byDateDesc, publicOnly, shortStamp, stamp } from "../lib/format";

const projects = publicOnly(await getCollection("projects"))
  .sort(byDateDesc)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);

const posts = publicOnly(await getCollection("blog")).sort(byDateDesc).slice(0, 4);

/* The headshot. Drop any `portrait.*` into public/media/ and it is
   picked up here at build time — no code change, no config. Until
   then the hero holds an empty plate at the same proportions, so the
   layout does not move when the photograph arrives. */
const MEDIA = "public/media";
const portrait = existsSync(MEDIA)
  ? readdirSync(MEDIA)
      .filter((f) => /^portrait\.(jpe?g|png|webp|avif)$/i.test(f))
      .map((f) => `/media/${f}`)[0]
  : undefined;

---

<Base section="Index — 00" description={site.description}>
  {/* ============ THE POSTER =====================================
      Three shapes far bigger than the viewport, the figure, and the
      type — all on one sheet, all overlapping, none of it in a box.
      ============================================================ */}
  <section class="poster" id="poster" data-rail-label="Masthead">
    <div class="poster__stage">

      <figure class="poster__figure">
        {
          portrait ? (
            <Photo src={portrait} alt={site.name} ratio="3/2" loading="eager" />
          ) : (
            <div class="plate-empty plate-empty--portrait">
              <span class="label num">PORTRAIT</span>
            </div>
          )
        }
        <figcaption class="poster__whisper">the spiritual double</figcaption>
      </figure>


      <p class="poster__note poster__note--a label num">
        LAT 37.4275<br />LON −122.1697
      </p>
      <p class="poster__note poster__note--b label num">
        1-BIT · ATKINSON<br />PLATE 1/1
      </p>

      <h1 class="poster__name title title--xl">{site.name}</h1>

      <p class="poster__role label label--wide">
        {site.role} · {site.location} · {stamp(new Date())}
      </p>
    </div>

    {/* The baseline, straight off the foot of the original sheet. */}
    <div class="poster__base">
      <Ruler step={8} major={5} height={18} numbered />
    </div>
  </section>

  {/* ============ STATEMENT ======================================= */}
  <section class="page section" id="statement" data-rail-label="Statement">
    <div class="statement">
      <p class="statement__lede" data-typelock>
        I make things and then I write about making them. Some of it is
        screens. Some of it is clay. Some of it is a pile of walnut
        offcuts that will eventually become a box.
      </p>

      <div class="columns statement__body" data-reveal>
        <p>
          This site is deliberately built out of two colours. Every
          photograph you see has been thrown through a dithering
          algorithm in your browser and reduced to pure black and pure
          white — the same trick that let a 1984 Macintosh with no
          greyscale at all pretend it had a camera.
        </p>
        <p>
          What looks like grey is a lie your eye is telling you. Get
          close to the screen and the illusion falls apart into a field
          of dots; step back and a photograph reassembles itself. That
          gap between what is there and what you see is more or less
          the whole reason I like design.
        </p>
        <p>
          Underneath the noise it is a plain, fast, accessible document.
          Turn JavaScript off and you still get everything: the writing,
          the work, the photographs, unprocessed. Nothing here moves on
          its own — the page only moves when you do.
        </p>
      </div>
    </div>

    <div class="statement__wedge" data-reveal>
      <p class="label" style="margin-bottom: 0.6rem">Fig. 0.1 — Step wedge</p>
      <ToneScale steps={12} pitch={6} height={40} />
    </div>
  </section>


  {/* ============ WORK ============================================ */}
  <section class="page section" id="work" data-rail-label="Work">

    <div class="section__head">
      <h2 class="label label--wide">
        <span class="section__no num">02</span> Selected Work
      </h2>
      <a class="section__more label" href="/projects/" data-scramble>
        All projects →
      </a>
    </div>

    {
      projects.length > 0 ? (
        <div class="grid grid--3" data-reveal-group="90">
          {projects.map((p, i) => (
            <a class="card" href={`/projects/${p.id}/`} data-reveal>
              <Plate
                no={p.data.plate ?? `2.${i + 1}`}
                caption={p.data.title}
                meta={String(p.data.year)}
                hover
              >
                {p.data.cover ? (
                  <Photo src={p.data.cover} alt={p.data.coverAlt ?? ""} ratio="4/3" />
                ) : (
                  <div class="plate-empty plate-empty--4x3">
                    <Texture type={["hatch", "ramp", "contour"][i % 3] as never} seed={i * 7 + 3} density={0.45} />
                  </div>
                )}
              </Plate>
              <p class="card__summary">{p.data.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty label">
          No projects yet — add a markdown file to src/content/projects/.
        </p>
      )
    }
  </section>


  {/* ============ WRITING ========================================= */}
  <section class="page section" id="writing" data-rail-label="Writing">

    <div class="section__head">
      <h2 class="label label--wide">
        <span class="section__no num">03</span> Recent Writing
      </h2>
      <a class="section__more label" href="/blog/" data-scramble>
        All posts →
      </a>
    </div>

    {
      posts.length > 0 ? (
        <ul class="rows" data-reveal-group="60">
          {posts.map((post, i) => (
            <EntryRow
              href={`/blog/${post.id}/`}
              no={`3.${i + 1}`}
              title={post.data.title}
              summary={post.data.summary}
              date={shortStamp(post.data.date)}
              tags={post.data.tags}
            />
          ))}
        </ul>
      ) : (
        <p class="empty label">
          No posts yet — add a markdown file to src/content/blog/.
        </p>
      )
    }
  </section>




  {/* ============ CLOSING ========================================= */}
  <section class="page section" id="close" data-rail-label="Contact">

    <div class="closing">
      <Plate no="0.2" caption="Plate reserved" meta="EMPTY">
        <div class="plate-empty plate-empty--16x9">
          <Texture type="scan" seed={29} density={0.55} />
        </div>
      </Plate>

      <div class="closing__note">
        <p class="label" data-reveal>Say hello</p>
        <p class="closing__big" data-reveal>
          <a href={`mailto:${site.email}`} data-scramble="both">
            {site.email}
          </a>
        </p>
        <p class="closing__body" data-reveal>
          I like talking about typography, glaze chemistry, hand tools,
          and why early computer graphics looked the way they did. If
          you want to work together, or just argue about Atkinson versus
          Floyd–Steinberg, the inbox is open.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- the poster --------------------------------------
     Nothing here is in a box. The shapes are larger than the
     viewport on purpose: you are looking at a detail of something
     bigger, which is what makes them read as objects rather than
     icons. --------------------------------------------------- */

  .poster {
    position: relative;
    border-bottom: var(--hair);
  }

  .poster__stage {
    position: relative;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--s-16) var(--gutter) var(--s-8);
    min-height: min(84vh, 46rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }




  /* The object hangs off the left edge of the stage, out past the
     page gutter so it nearly touches the rail, and runs the full
     height of the block. z-index 0 keeps it behind the picture and
     the type — it is part of the sheet, not a sticker on it. */


  /* Room on the left for it, so the photograph is not sitting on top
     of the object it is meant to be next to. */
  .poster__figure {
    position: relative;
    z-index: 2;
    /* Flush to the left of the stage rather than pushed right. */
    margin: 0 auto 0 0;
    width: min(52%, 32rem);
  }

  /* The light, lowercase aside — the "the spiritual double" voice. */
  .poster__whisper {
    position: absolute;
    right: -3rem;
    top: 12%;
    font-family: var(--font-serif);
    font-size: clamp(0.9rem, 1.7vw, 1.5rem);
    white-space: nowrap;
  }

  .poster__note {
    position: absolute;
    z-index: 3;
    line-height: 1.5;
  }
  .poster__note--a {
    left: var(--gutter);
    bottom: 24%;
  }
  .poster__note--b {
    right: var(--gutter);
    top: 30%;
    text-align: right;
  }

  .poster__name {
    position: relative;
    z-index: 3;
    margin: var(--s-12) 0 var(--s-3) auto;
    max-width: 22ch;
  }

  .poster__role {
    position: relative;
    z-index: 3;
    text-align: right;
  }

  .poster__base {
    position: relative;
    z-index: 3;
    padding-inline: var(--gutter);
  }


  @media (max-width: 52rem) {
    .poster__stage {
      min-height: 0;
      padding-top: var(--s-8);
    }
    .poster__figure {
      width: 100%;
    }
    .poster__whisper {
      right: auto;
      left: 0;
      top: auto;
      bottom: -2rem;
    }
    .poster__note {
      display: none;
    }
    .poster__name,
    .poster__role {
      margin-left: 0;
      text-align: left;
      width: 100%;
    }
  }

  /* ---------- statement -------------------------------------- */
  .statement {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-8);
  }

  .statement__lede {
    font-size: var(--t-lg);
    line-height: var(--lead-snug);
    max-width: 24ch;
    text-wrap: balance;
  }

  .statement__wedge {
    margin-top: var(--s-12);
    max-width: 44rem;
  }

  @media (min-width: 60rem) {
    .statement {
      grid-template-columns: 1fr 1.3fr;
      gap: var(--s-16);
      align-items: start;
    }
    .statement__lede {
      position: sticky;
      top: 5rem;
    }
  }

  /* ---------- section chrome ---------------------------------
     No rules between sections on this page: a full-width hairline
     every few screens turns one sheet back into a stack of bands,
     which is exactly what the shapes are there to dissolve. The
     z-index lifts the content clear of the field layer. */
  .section {
    border-top: 0;
  }

  /* Content sits above the shape layer. */
  .section > *:not(.shape) {
    position: relative;
    z-index: 1;
  }

  .section__no {
    margin-right: 0.8em;
  }

  .section__more a,
  a.section__more {
    text-decoration: none;
    border-bottom: var(--hair);
  }
  .section__more a:hover,
  a.section__more:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .empty {
    border: var(--rule) dashed var(--ink);
    padding: var(--s-6);
    text-align: center;
  }

  /* ---------- grids ------------------------------------------ */
  .grid {
    display: grid;
    gap: var(--s-6);
  }
  .grid--3 {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .grid--4 {
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    margin-top: var(--s-6);
  }

  .card {
    text-decoration: none;
    display: block;
  }

  .card__summary {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    line-height: var(--lead-body);
  }

  .card__blank {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background-image: repeating-linear-gradient(
      45deg,
      var(--ink) 0 1px,
      transparent 1px 7px
    );
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: var(--hair);
  }

  /* ---------- closing ---------------------------------------- */
  .closing {
    display: grid;
    gap: var(--s-8);
  }

  @media (min-width: 60rem) {
    .closing {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--s-16);
      align-items: center;
    }
  }

  .closing__big {
    font-size: var(--t-lg);
    line-height: var(--lead-tight);
    margin-block: var(--s-3);
    word-break: break-word;
  }

  .closing__big a {
    text-decoration: none;
    border-bottom: var(--rule-thick) solid var(--ink);
  }
  .closing__big a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .closing__body {
    font-size: var(--t-sm);
    line-height: var(--lead-body);
    max-width: 32rem;
  }
</style>
