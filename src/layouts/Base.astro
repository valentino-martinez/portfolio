---
/**
 * Base — the document shell every page sits inside.
 *
 * Order matters here: the inline script in <head> runs before the
 * first paint so the page never flashes the wrong polarity, and it
 * sets `js-ready` so reveal animations only arm themselves when
 * there is JavaScript to disarm them again.
 */
import "../styles/global.css";
import { site } from "../site";
import Masthead from "../components/Masthead.astro";

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title,
  description = site.description,
  class: className = "",
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : site.name;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

/* A 1-bit favicon. Built with string concatenation rather than a
   nested template literal: Astro's frontmatter scanner mis-detects
   the closing `---` fence when backticks nest inside `${}`. */
const FAVICON_SVG =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8" shape-rendering="crispEdges">' +
  '<rect width="8" height="8" fill="#fff"/>' +
  '<path fill="#000" d="M0 0h1v1H0zm2 0h1v1H2zm2 0h1v1H4zm2 0h1v1H6zM1 1h1v1H1zm2 0h1v1H3zm2 0h1v1H5zm2 0h1v1H7zM0 2h1v1H0zm4 0h1v1H4zm2 0h1v1H6zM1 3h1v1H1zm4 0h1v1H5zM0 4h1v1H0zm2 0h1v1H2zm4 0h1v1H6zM3 5h1v1H3zm4 0h1v1H7zM0 6h1v1H0zm4 0h1v1H4zM1 7h1v1H1zm4 0h1v1H5zm2 0h1v1H7z"/>' +
  "</svg>";
const favicon = "data:image/svg+xml," + encodeURIComponent(FAVICON_SVG);
---

<!doctype html>
<html lang="en" data-invert="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Runs before first paint. Keep it tiny and dependency-free. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js-ready");
        try {
          var saved = localStorage.getItem("ap:invert");
          if (saved === "on" || saved === "off") {
            root.setAttribute("data-invert", saved);
            return;
          }
        } catch (e) {
          /* storage blocked; fall through to the system preference */
        }
        var dark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        root.setAttribute("data-invert", dark ? "on" : "off");
      })();
    </script>
  </head>

  <body class={className}>
    <a class="skip-link" href="#main">Skip to content</a>


    <Masthead />


    <main id="main" class="shell">
      <slot />
    </main>


    <script>
      import "../lib/main";
    </script>
  </body>
</html>

<style is:global>
  .shell {
    position: relative;
  }


</style>
